# Configuración de Flask
FLASK_APP=app.py
FLASK_ENV=production

# Base de Datos
DATABASE_URL=postgresql://catalogo_user:catalogo_pass@db:5432/catalogo_db

# Seguridad
SECRET_KEY=cambiar-por-clave-aleatoria-en-produccion
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar-contraseña-en-produccion

# CONTPAQi Sync (opción 1: consulta directa desde la app cloud)
CONTPAQ_SYNC_ENABLED=0
CONTPAQ_SYNC_INTERVAL_MINUTES=60
CONTPAQ_SYNC_STARTUP_DELAY_SECONDS=30
CONTPAQ_CUSTOMER_NAME=RUTH VERDUZCO SANTOS
CONTPAQ_START_DATE=2025-01-01
CONTPAQ_END_DATE=
CONTPAQ_CHUNK_DAYS=31
CONTPAQ_REQUEST_TIMEOUT=300
CONTPAQ_D_FALLBACK_DAYS=31

CONTPAQ_SQLSERVER_HOST=10.0.0.10
CONTPAQ_SQLSERVER_PORT=1433
CONTPAQ_SQLSERVER_DATABASE=CompacComercial
CONTPAQ_SQLSERVER_USER=usuario_sql
CONTPAQ_SQLSERVER_PASSWORD=password_sql
CONTPAQ_SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
CONTPAQ_SQLSERVER_TRUST_CERT=yes
CONTPAQ_SQLSERVER_TRUSTED_CONNECTION=0

# API key para push seguro (opción 2: agente local inhouse -> nube)
SYNC_API_KEY=pon_una_clave_larga_y_segura
CONTPAQ_CLOUD_PUSH_URL=https://controlcalidad360.site/api/contpaq/sync/push
CONTPAQ_EXISTENCIA_CLOUD_PUSH_URL=https://controlcalidad360.site/api/contpaq/existencia/sync/push
CONTPAQ_MM_LOOKBACK_DAYS=84
CONTPAQ_MM_MIN_WEEKS=2.0
CONTPAQ_MM_MAX_WEEKS=6.0

# Empaque360 (agente en planta MySQL -> portal /seguimiento)
EMPAQUE_CLOUD_PUSH_URL=https://controlcalidad360.site/api/empaque/sync/push
EMPAQUE_MYSQL_HOST=192.168.0.6
EMPAQUE_MYSQL_PORT=3307
EMPAQUE_MYSQL_DATABASE=empaqueops
EMPAQUE_MYSQL_USER=empaque_app
EMPAQUE_MYSQL_PASSWORD=password_mysql
EMPAQUE_LOOKBACK_DAYS=45
EMPAQUE_CHUNK_ORDERS=80
EMPAQUE_REQUEST_TIMEOUT=180

# Odoo (portal cliente: lista de precios con las 6 reglas)
ODOO_URL=https://verduzco.odoo.com
ODOO_DB=verduzco-prd-26916754
ODOO_USERNAME=sistemas@verduzco.mx
ODOO_API_KEY=pon_api_key_odoo
